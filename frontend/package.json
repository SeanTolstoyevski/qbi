{
  "name": "qbi-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"src/**/*.{js,vue}\" vite.config.js",
    "format:check": "prettier --check \"src/**/*.{js,vue}\" vite.config.js"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "prettier": "^3.9.6",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  }
}
